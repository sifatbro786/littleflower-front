# ---- Public site ----
# Canonical URL used for metadata, sitemap and JSON-LD.
# Vercel demo: https://littleflower-school.vercel.app · VPS: https://littleflowerintschool.com
NEXT_PUBLIC_SITE_URL=https://littleflower-school.vercel.app

# true when Cloudflare sits in front (changes which header holds the real client IP)
BEHIND_CLOUDFLARE=false

# ---- Data mode ----
# demo (default, Vercel client preview): sample data, no backend, contact form answers without sending.
# live (local dev + VPS): everything comes from the Express API (contact mail goes through its queue).
# Set BEFORE `next build` and `next start`.
DATA_MODE=demo
# Required when DATA_MODE=live (no /api, no trailing slash)
API_INTERNAL_URL=http://127.0.0.1:4020
# Live only: same value as littleflower-back REVALIDATE_SECRET (16+ chars)
REVALIDATE_SECRET=

# Demo mode only: signs the demo session cookie (32+ chars)
SESSION_SECRET=
